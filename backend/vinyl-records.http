@token = COLARAQUI

### Criar disco - Pink Floyd

POST http://localhost:3000/api/vinyl-records
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "The Dark Side of the Moon",
    "releaseYear": 1973,
    "price": 199.90,
    "condition": "Novo",
    "rpmSpeed": 33,
    "stockQuantity": 5,
    "artistId": 1,
    "genreId": 1
}

### Criar disco - Metallica

POST http://localhost:3000/api/vinyl-records
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Master of Puppets",
    "releaseYear": 1986,
    "price": 179.90,
    "condition": "Novo",
    "rpmSpeed": 33,
    "stockQuantity": 3,
    "artistId": 2,
    "genreId": 2
}

### Criar disco - Wish You Were Here

POST http://localhost:3000/api/vinyl-records
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Wish You Were Here",
    "releaseYear": 1975,
    "price": 189.90,
    "condition": "Usado - VG",
    "rpmSpeed": 33,
    "stockQuantity": 2,
    "artistId": 1,
    "genreId": 1
}

### Listar discos

GET http://localhost:3000/api/vinyl-records
Authorization: Bearer {{token}}

### Buscar disco por ID

GET http://localhost:3000/api/vinyl-records/1
Authorization: Bearer {{token}}

### Disco inexistente

GET http://localhost:3000/api/vinyl-records/999
Authorization: Bearer {{token}}

### Artista inexistente

POST http://localhost:3000/api/vinyl-records
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Disco Teste",
    "releaseYear": 2000,
    "price": 50,
    "condition": "Novo",
    "rpmSpeed": 33,
    "stockQuantity": 1,
    "artistId": 999,
    "genreId": 1
}

